# Local build and reverse-engineering scratch space. Only the README that
# explains what is in it is tracked; everything else lives on one machine.
/bin/*
!/bin/README.md

# Output of `make package`: the .deb and the tree it is staged in. Both are
# rebuilt from scratch every run, so neither is worth keeping.
/dist/*

# Scratch left by editor and agent tooling.
.freebuff/

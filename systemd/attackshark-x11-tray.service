# Optional systemd user unit for the Attack Shark X11 tray app.
#
# Nothing installs this for you: neither the .deb nor tools/install.sh adds a
# startup entry, because where the tray should start is the user's decision. Two
# routes, pick one:
#
#   * your desktop's startup applications, pointing at the tray binary
#     (/usr/bin/attackshark-x11-tray from the package, or
#     ~/.local/bin/attackshark-x11-tray from a source install), or
#   * this unit, if you prefer systemd to manage the process:
#
#     mkdir -p ~/.config/systemd/user
#     cp systemd/attackshark-x11-tray.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now attackshark-x11-tray.service
#
# Do not enable both. The app takes a single-instance lock, so the loser exits
# with a message rather than drawing a second tray icon - but a unit restarting
# next to a working icon is still noise, which is what the start limit below is
# for.

[Unit]
Description=Attack Shark X11 battery and DPI stage tray monitor
Documentation=file:%h/.local/share/doc/attackshark-x11/README.md
# A duplicate instance exits immediately, which is a permanent condition, unlike
# a receiver that is temporarily unplugged (the app retries that internally
# without exiting). Give up after a few attempts rather than restarting for ever.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/attackshark-x11-tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
